  "query": "SELECT r.id, r.application_id, a.client_id::text AS \"client_id!\", a.client_name\n             FROM grant_requests r\n             JOIN applications a ON a.id = r.application_id\n            WHERE r.guild_id = $1 AND r.status = 'pending'\n            ORDER BY r.id",
