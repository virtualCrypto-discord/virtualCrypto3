  "query": "SELECT assets.amount, currencies.name, currencies.unit\n           FROM assets\n           JOIN currencies ON currencies.id = assets.currency_id\n           JOIN users ON users.id = assets.user_id\n          WHERE users.discord_id = $1\n          ORDER BY currencies.unit\n          LIMIT $2\n         OFFSET $3",
